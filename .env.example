# MongoDB Atlas 연결 문자열 (DB 이름 포함)
# 예: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/todo?retryWrites=true&w=majority
DATABASE_URL=""

# Auth.js v5 세션 암호화 키. 생성: npx auth secret
AUTH_SECRET=""

# Vercel 이 아닌 곳(로컬 next start, 자체 호스팅)에서 Host 헤더를 신뢰하도록.
# Vercel 배포 시에는 자동 처리되므로 없어도 됨.
AUTH_TRUST_HOST=true
